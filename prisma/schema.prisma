  lpos      ProjectOrgLpo[]

  @@index([projectId, procurementId, status])
  @@index([supplierId])
  @@map("project_org_award")
}

model ProjectOrgContract {
  id             String                @id @default(uuid())
  projectId      String                @map("project_id")
  procurementId  String                @map("procurement_id")
  procurement    ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  awardId        String?               @map("award_id")
  award          ProjectOrgAward?      @relation(fields: [awardId], references: [id], onDelete: SetNull)
  supplierId     String                @map("supplier_id")
  supplier       ProjectOrgSupplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  contractNumber String                @map("contract_number") @db.VarChar(32)
  contractValue  Decimal               @map("contract_value") @db.Decimal(18, 2)
  status         OrgContractStatus     @default(DRAFT)
  startDate      DateTime?             @map("start_date")
  endDate        DateTime?             @map("end_date")
  issuedAt       DateTime?             @map("issued_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([projectId, contractNumber])
  @@index([procurementId, status])
  @@map("project_org_contract")
}

model ProjectOrgLpo {
  id            String                @id @default(uuid())
  projectId     String                @map("project_id")
  procurementId String                @map("procurement_id")
  procurement   ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  awardId       String?               @map("award_id")
  award         ProjectOrgAward?      @relation(fields: [awardId], references: [id], onDelete: SetNull)
  supplierId    String                @map("supplier_id")
  supplier      ProjectOrgSupplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lpoNumber     String                @map("lpo_number") @db.VarChar(32)
  lpoValue      Decimal               @map("lpo_value") @db.Decimal(18, 2)
  status        OrgLpoStatus          @default(DRAFT)
  issuedAt      DateTime?             @map("issued_at")
  acceptedAt    DateTime?             @map("accepted_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@unique([projectId, lpoNumber])
  @@index([procurementId, status])
  @@map("project_org_lpo")
}

model ProjectOrgDelivery {
  id                  String                @id @default(uuid())
  projectId           String                @map("project_id")
  procurementId       String                @map("procurement_id")
  procurement         ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  status              OrgDeliveryStatus     @default(DRAFT)
  deliveryDate        DateTime?             @map("delivery_date")
  recordedByOrgUserId String?               @map("recorded_by_org_user_id")
  recordedBy          ProjectOrgUser?       @relation("DeliveryRecorder", fields: [recordedByOrgUserId], references: [id], onDelete: SetNull)
  remarks             String?               @db.Text
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  lines      ProjectOrgDeliveryLine[]
  inspection ProjectOrgInspection?
  invoices   ProjectOrgInvoice[]

  @@index([projectId, procurementId, status])
  @@map("project_org_delivery")
}

model ProjectOrgDeliveryLine {
  id               String             @id @default(uuid())
  deliveryId       String             @map("delivery_id")
  delivery         ProjectOrgDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  itemName         String             @map("item_name") @db.VarChar(255)
  orderedQuantity  Decimal            @map("ordered_quantity") @db.Decimal(18, 2)
  receivedQuantity Decimal            @map("received_quantity") @db.Decimal(18, 2)
  acceptedQuantity Decimal            @default(0) @map("accepted_quantity") @db.Decimal(18, 2)
  rejectedQuantity Decimal            @default(0) @map("rejected_quantity") @db.Decimal(18, 2)
  unitOfMeasure    String?            @map("unit_of_measure") @db.VarChar(64)

  @@index([deliveryId])
  @@map("project_org_delivery_line")
}

model ProjectOrgInspection {
  id                   String              @id @default(uuid())
  projectId            String              @map("project_id")
  deliveryId           String              @unique @map("delivery_id")
  delivery             ProjectOrgDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status               OrgInspectionStatus @default(PENDING)
  resultNotes          String?             @map("result_notes") @db.Text
  inspectedAt          DateTime?           @map("inspected_at")
  inspectedByOrgUserId String?             @map("inspected_by_org_user_id")
  inspectedBy          ProjectOrgUser?     @relation("InspectionRecorder", fields: [inspectedByOrgUserId], references: [id], onDelete: SetNull)
  /// Optional committee context for inspection/acceptance (educational, not an org role).
  committeeId          String?             @map("committee_id") @db.VarChar(36)
  committeeRole        String?             @map("committee_role") @db.VarChar(32)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@map("project_org_inspection")
}

model ProjectOrgInvoice {
  id                 String                @id @default(uuid())
  projectId          String                @map("project_id")
  procurementId      String                @map("procurement_id")
  procurement        ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  /// Optional link to the delivery this invoice relates to.
  deliveryId         String?               @map("delivery_id")
  delivery           ProjectOrgDelivery?   @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  invoiceNumber      String                @map("invoice_number") @db.VarChar(64)
  amount             Decimal               @db.Decimal(18, 2)
  status             OrgInvoiceStatus      @default(DRAFT)
  invoiceDate        DateTime?             @map("invoice_date")
  createdByOrgUserId String?               @map("created_by_org_user_id")
  createdBy          ProjectOrgUser?       @relation("InvoiceCreator", fields: [createdByOrgUserId], references: [id], onDelete: SetNull)
  certifiedAt        DateTime?             @map("certified_at")
  verifiedAt         DateTime?             @map("verified_at")
  rejectionReason    String?               @map("rejection_reason") @db.Text
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  payments ProjectOrgPayment[]

  @@unique([projectId, invoiceNumber])
  @@index([procurementId, status])
  @@index([deliveryId])
  @@map("project_org_invoice")
}

model ProjectOrgPayment {
  id                  String                @id @default(uuid())
  projectId           String                @map("project_id")
  procurementId       String                @map("procurement_id")
  procurement         ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  invoiceId           String                @map("invoice_id")
  invoice             ProjectOrgInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount              Decimal               @db.Decimal(18, 2)
  status              OrgPaymentStatus      @default(PENDING)
  paymentReference    String?               @map("payment_reference") @db.VarChar(128)
  paymentDate         DateTime?             @map("payment_date")
  approvedByOrgUserId String?               @map("approved_by_org_user_id")
  approvedBy          ProjectOrgUser?       @relation("PaymentApprover", fields: [approvedByOrgUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([projectId, procurementId, status])
  @@index([invoiceId])
  @@map("project_org_payment")
}

model ProjectOrgWorkflowInstance {
  id                String                     @id @default(uuid())
  projectId         String                     @map("project_id")
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processFlowId     String                     @map("process_flow_id")
  processFlow       ProjectOrgProcessFlow      @relation(fields: [processFlowId], references: [id], onDelete: Restrict)
  /// Polymorphic business entity type (e.g. requisition, procurement).
  entityType        String                     @map("entity_type") @db.VarChar(64)
  entityId          String                     @map("entity_id") @db.VarChar(36)
  requisitionId     String?                    @map("requisition_id")
  requisition       ProjectOrgRequisition?     @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  procurementPlanId String?                    @map("procurement_plan_id")
  procurementPlan   ProjectOrgProcurementPlan? @relation(fields: [procurementPlanId], references: [id], onDelete: SetNull)
  budgetId          String?                    @map("budget_id")
  budget            ProjectOrgBudget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  procurementId     String?                    @map("procurement_id")
  procurement       ProjectOrgProcurement?     @relation(fields: [procurementId], references: [id], onDelete: SetNull)
  triggerKey        String                     @map("trigger_key") @db.VarChar(64)
  status            OrgWorkflowInstanceStatus  @default(ACTIVE)
  currentStepNumber Int?                       @map("current_step_number")
  startedAt         DateTime                   @default(now()) @map("started_at")
  completedAt       DateTime?                  @map("completed_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  tasks   ProjectOrgWorkflowTask[]
  actions ProjectOrgWorkflowAction[]

  @@index([projectId, status, startedAt])
  @@index([requisitionId])
  @@index([procurementPlanId])
  @@index([budgetId])
  @@index([procurementId])
  @@index([entityType, entityId])
  @@index([processFlowId, status])
  @@map("project_org_workflow_instance")
}

model ProjectOrgWorkflowTask {
  id                String                     @id @default(uuid())
  projectId         String                     @map("project_id")
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instanceId        String                     @map("instance_id")
  instance          ProjectOrgWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  processFlowItemId String?                    @map("process_flow_item_id")
  processFlowItem   ProjectOrgProcessFlowItem? @relation(fields: [processFlowItemId], references: [id], onDelete: SetNull)
  stepNumber        Int                        @map("step_number")
  title             String                     @db.VarChar(255)
  requiredRoleName  String                     @map("required_role_name") @db.VarChar(128)
  assigneeOrgUserId String?                    @map("assignee_org_user_id")
  assignee          ProjectOrgUser?            @relation("WorkflowTaskAssignee", fields: [assigneeOrgUserId], references: [id], onDelete: SetNull)
  status            OrgWorkflowTaskStatus      @default(PENDING)
  dueAt             DateTime?                  @map("due_at")
  completedAt       DateTime?                  @map("completed_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  actions ProjectOrgWorkflowAction[]

  @@index([projectId, status, createdAt])
  @@index([assigneeOrgUserId, status])
  @@index([instanceId, stepNumber])
  @@map("project_org_workflow_task")
}

model ProjectOrgWorkflowAction {
  id             String                     @id @default(uuid())
  projectId      String                     @map("project_id")
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instanceId     String                     @map("instance_id")
  instance       ProjectOrgWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  taskId         String?                    @map("task_id")
  task           ProjectOrgWorkflowTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorOrgUserId String?                    @map("actor_org_user_id")
  actor          ProjectOrgUser?            @relation("WorkflowActionActor", fields: [actorOrgUserId], references: [id], onDelete: SetNull)
  /// Snapshot of active context at action time.
  actorRoleName  String?                    @map("actor_role_name") @db.VarChar(128)
  committeeId    String?                    @map("committee_id") @db.VarChar(36)
  committeeRole  String?                    @map("committee_role") @db.VarChar(32)
  decision       OrgWorkflowDecision
  comment        String?                    @db.Text
  previousStatus String?                    @map("previous_status") @db.VarChar(64)
  newStatus      String?                    @map("new_status") @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@index([instanceId, createdAt])
  @@index([projectId, createdAt])
  @@map("project_org_workflow_action")
}
