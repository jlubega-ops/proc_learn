generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EXAMINER
  SYSTEM_ADMIN
}

enum Sex {
  MALE
  FEMALE
}

/// Physical campus where the student studies (MUBS).
enum Campus {
  MAIN
  ARUA
  MBARARA
  JINJA
  MBALE
}

enum UserAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

enum ProjectPurpose {
  PRACTICE
  ASSESSMENT
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum ProjectEnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

/// Dedicated attempt lifecycle (never overloaded onto ProjectEnrollment).
enum ProjectAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  COMPLETED
  RETURNED
}

/// How an Academic Project mixes automatic domain checks and examiner marks.
enum AssessmentGradingMode {
  AUTOMATIC
  MANUAL
  COMBINED
}

/// Released results: SUMMARY = score only; DETAILS = score plus marks per section and item.
enum AssessmentResultsView {
  SUMMARY
  DETAILS
}

/// Domain-backed checkpoint kinds — evaluation READS procurement progress / records.
enum AssessmentCheckpointKind {
  /// Macro teaching stage is fully done (deriveOrganisationProcurementProgress).
  STAGE_COMPLETED
  /// Macro teaching stage reached (done, current, or later progress).
  STAGE_REACHED
  /// At least one procurement case uses the required method.
  PROCUREMENT_METHOD
  /// The ProjectAttempt itself is submitted (or beyond).
  ATTEMPT_SUBMITTED
}

/// Lifecycle of a ProjectAttempt grade row.
enum AttemptGradeStatus {
  NOT_GRADED
  /// Auto score computed; manual mark still required (COMBINED).
  AUTO_SCORED
  /// Final score is available (auto-only, manual-only, or both entered).
  GRADED
}

enum PassFailResult {
  PASS
  FAIL
}

/// Who participates in an academic year (demos wired in later phases).
enum AcademicParticipationType {
  STUDENT
  EXAMINER_DEMO
  SYSTEM_ADMIN_DEMO
}

/// Lifecycle of a student's (or demo's) enrollment in one AcademicYear.
enum AcademicEnrollmentStatus {
  ACTIVE
  HISTORICAL
}

/// Lifecycle of an academic slate over a durable My Organisation (personal Project).
enum OrgAcademicSlateStatus {
  CURRENT
  HISTORICAL
}

enum OrgUnitType {
  DEPARTMENT
  UNIT
  DIVISION
  SECTION
  OTHER
}

enum OrgCommitteeType {
  CONTRACTS
  EVALUATION
  NEGOTIATION
  INSPECTION_ACCEPTANCE
}

enum OrgCommitteeMemberRole {
  CHAIRPERSON
  MEMBER
  SECRETARY
}

enum OrgCommitteeMembershipStatus {
  ACTIVE
  INACTIVE
  ENDED
}

enum OrgPlanningPeriodStatus {
  UPCOMING
  OPEN
  CLOSED
}

enum OrgBudgetStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  REJECTED
  APPROVED
  CLOSED
}

enum OrgProcurementPlanStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  REJECTED
  APPROVED
  CANCELLED
  CLOSED
}

enum OrgRequisitionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  REJECTED
  APPROVED
  CANCELLED
}

enum OrgWorkflowInstanceStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum OrgWorkflowTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  RETURNED
  REJECTED
  CANCELLED
}

enum OrgWorkflowDecision {
  APPROVE
  RETURN
  REJECT
  VERIFY
  FLAG_EXCEPTION
  SUBMIT
  COMPLETE
  SELECT_METHOD
}

/// Official PPDA-style methods — each maps to an independent process engine.
enum OrgProcurementMethod {
  OPEN_DOMESTIC
  OPEN_INTERNATIONAL
  RESTRICTED_DOMESTIC
  RESTRICTED_INTERNATIONAL
  QUOTATION
  MICRO
  DIRECT
}

/// Lifecycle status for post-requisition Procurement business records.
enum OrgProcurementStatus {
  DRAFT
  METHOD_SELECTED
  IN_PROGRESS
  SOLICITATION
  EVALUATION
  AWARD_PENDING
  AWARDED
  CONTRACTING
  CONTRACT_ACTIVE
  DELIVERY
  INSPECTION
  INVOICING
  PAYMENT
  READY_FOR_CLOSURE
  CLOSED
  CANCELLED
  REJECTED
}

enum OrgProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgPurchaseInstructionStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
}

enum OrgDeliveryNoteStatus {
  SUBMITTED
  RECEIVED
}

enum OrgSolicitationType {
  RFQ
  TENDER
}

enum OrgSolicitationStatus {
  DRAFT
  REVIEW
  APPROVED
  ISSUED
  ADVERTISED
  OPEN
  CLOSED
}

enum OrgOfferType {
  QUOTATION
  BID
}

enum OrgOfferStatus {
  SUBMITTED
  OPENED
  WITHDRAWN
  REJECTED
  /// Received after the closing date — recorded but never opened or evaluated.
  LATE
}

enum OrgEvaluationReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
}

enum OrgPostQualificationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum OrgAwardStatus {
  DRAFT
  APPROVED
  COMMUNICATED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum OrgContractStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SIGNED
  ISSUED
  ACTIVE
  DECLINED
  CANCELLED
}

enum OrgLpoStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ISSUED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum OrgDeliveryStatus {
  DRAFT
  PARTIAL
  COMPLETE
  DISPUTED
}

enum OrgInspectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  PARTIAL
}

enum OrgInvoiceStatus {
  DRAFT
  RECEIVED
  CERTIFIED
  VERIFIED
  APPROVED_FOR_PAYMENT
  REJECTED
}

enum OrgPaymentStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

model User {
  id    String @id @default(uuid())
  email String @unique @db.VarChar(255)

  firstName       String  @default("User") @map("first_name") @db.VarChar(100)
  middleName      String? @map("middle_name") @db.VarChar(100)
  lastName        String  @default("Member") @map("last_name") @db.VarChar(100)
  sex             Sex?    @map("sex")
  /// Profile image: upload URL, external https link, or synced from Google when empty.
  profilePhotoUrl String? @map("profile_photo_url") @db.VarChar(2048)

  passwordHash String @map("password_hash") @db.VarChar(255)

  accountStatus      UserAccountStatus @default(ACTIVE) @map("account_status")
  activatedAt        DateTime?         @default(now()) @map("activated_at")
  suspendedReason    String?           @map("suspended_reason") @db.VarChar(1024)
  lastLoginAt        DateTime?         @map("last_login_at")
  /// Students must set a personal password after first sign-in (default password is student number).
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  /// Bumped on every sign-in / suspension / password change; sessions carrying an older value are signed out.
  sessionVersion     Int               @default(0) @map("session_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings     UserSettings?
  userRoles    UserRole[]
  mediaObjects MediaObject[]

  studentProfile      StudentProfile?
  academicEnrollments StudentAcademicEnrollment[]
  authTokens          AuthToken[]
  notifications       Notification[]
  projects            Project[]
  projectEnrollments  ProjectEnrollment[]
  attemptGrades       ProjectAttemptGrade[]       @relation("AttemptGradedBy")

  @@map("user")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_role")
}

model UserSettings {
  id                     String     @id @default(uuid())
  userId                 String     @unique @map("user_id") @db.VarChar(36)
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                  String     @default("light") @db.VarChar(16)
  activeRole             Role       @default(STUDENT) @map("active_role")
  /// Student's current organisation shell: personal org or a per-attempt workspace.
  activeOrgProjectId     String?    @map("active_org_project_id") @db.VarChar(36)
  activeOrgProject       Project?   @relation("UserActiveOrg", fields: [activeOrgProjectId], references: [id], onDelete: SetNull)
  /// Staff Student Mode only (no StudentProfile): programme whose projects they follow.
  studentViewProgrammeId String?    @map("student_view_programme_id")
  studentViewProgramme   Programme? @relation("StudentViewProgramme", fields: [studentViewProgrammeId], references: [id], onDelete: SetNull)
  /// Staff Student Mode campus. Null = all campuses.
  studentViewCampus      Campus?    @map("student_view_campus")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  @@index([activeOrgProjectId])
  @@index([studentViewProgrammeId])
  @@map("user_settings")
}

model Programme {
  id                 String   @id @default(uuid())
  name               String   @db.VarChar(255)
  shortName          String   @map("short_name") @db.VarChar(64)
  isActive           Boolean  @default(true) @map("is_active")
  /// Default year of study (1–3) suggested for new students in this programme.
  defaultYearOfStudy Int      @default(3) @map("default_year_of_study")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  students            StudentProfile[]
  courses             Course[]
  projects            Project[]
  studentViewSettings UserSettings[]         @relation("StudentViewProgramme")
  processSettings     ProgrammeYearProcess[]

  @@map("programme")
}

/// Process switches per programme × academic year. No row = enabled (all processes are on by default).
model ProgrammeYearProcess {
  id              String       @id @default(uuid())
  programmeId     String       @map("programme_id")
  programme       Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  academicYearId  String       @map("academic_year_id")
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// Engine process code (e.g. BUDGETING).
  processCode     String       @map("process_code") @db.VarChar(64)
  isEnabled       Boolean      @default(true) @map("is_enabled")
  updatedByUserId String?      @map("updated_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([programmeId, academicYearId, processCode])
  @@index([academicYearId, programmeId])
  @@map("programme_year_process")
}

/// University academic year (e.g. 2025/2026). Distinct from org simulation financial years.
model AcademicYear {
  id          String   @id @default(uuid())
  /// Label such as "2025/2026".
  label       String   @unique @db.VarChar(16)
  description String?  @db.VarChar(512)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  /// Exactly one should be current; enforced in application service.
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  enrollments      StudentAcademicEnrollment[]
  orgSlates        OrgAcademicSlate[]
  projects         Project[]
  programmeProcess ProgrammeYearProcess[]

  @@index([isCurrent])
  @@map("academic_year")
}

/// Thin course catalogue for academic filtering (not org simulation).
model Course {
  id          String     @id @default(uuid())
  code        String     @unique @db.VarChar(32)
  name        String     @db.VarChar(255)
  programmeId String?    @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  description String?    @db.VarChar(512)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("course")
}

model StudentProfile {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentNumber      String    @unique @map("student_number") @db.VarChar(32)
  registrationNumber String    @map("registration_number") @db.VarChar(128)
  programmeId        String    @map("programme_id")
  programme          Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  yearOfStudy        Int       @default(3) @map("year_of_study")
  /// Campus the student is attached to (Main, Arua, Mbarara, Jinja, Mbale).
  campus             Campus    @default(MAIN)
  /// Compatibility denormalized label (admin forms/filters). Authoritative year participation is
  /// `StudentAcademicEnrollment` — keep this field in sync when enrollments change; do not treat it
  /// as long-term source of truth.
  academicYearLabel  String    @map("academic_year_label") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campus])
  @@map("student_profile")
}

/// Authoritative academic-year participation for a user (students; demos later).
/// Uniqueness: one row per (userId, academicYearId). History is preserved by status —
/// joining a new year marks prior ACTIVE enrollments HISTORICAL (never deletes).
model StudentAcademicEnrollment {
  id                String                    @id @default(uuid())
  userId            String                    @map("user_id")
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYearId    String                    @map("academic_year_id")
  academicYear      AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  status            AcademicEnrollmentStatus  @default(ACTIVE)
  participationType AcademicParticipationType @default(STUDENT) @map("participation_type")
  joinedAt          DateTime                  @default(now()) @map("joined_at")
  /// Set when the enrollment becomes HISTORICAL (e.g. student joins a newer year).
  endedAt           DateTime?                 @map("ended_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  /// One slate per organisation project for this academic enrollment.
  orgSlates       OrgAcademicSlate[]
  projectAttempts ProjectAttempt[]

  @@unique([userId, academicYearId])
  @@index([userId, status])
  @@index([academicYearId, status])
  @@index([participationType, status])
  @@map("student_academic_enrollment")
}

/// Academic-year participation context over one organisation Project (personal or attempt workspace).
/// One slate per (organisation project, academic enrollment) — never share a slate across orgs.
model OrgAcademicSlate {
  id             String                    @id @default(uuid())
  projectId      String                    @map("project_id")
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enrollmentId   String                    @map("enrollment_id")
  enrollment     StudentAcademicEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  academicYearId String                    @map("academic_year_id")
  academicYear   AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  status         OrgAcademicSlateStatus    @default(CURRENT)
  openedAt       DateTime                  @default(now()) @map("opened_at")
  closedAt       DateTime?                 @map("closed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  budgets         ProjectOrgBudget[]
  plans           ProjectOrgProcurementPlan[]
  requisitions    ProjectOrgRequisition[]
  procurements    ProjectOrgProcurement[]
  projectAttempts ProjectAttempt[]

  @@unique([projectId, enrollmentId])
  @@index([projectId, status])
  @@index([academicYearId, status])
  @@map("org_academic_slate")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @map("token_hash") @db.VarChar(128)
  type      AuthTokenType @map("type")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_token")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id") @db.VarChar(36)
  targetUserId String?  @map("target_user_id") @db.VarChar(36)
  eventType    String   @map("event_type") @db.VarChar(64)
  /// Copy of `meta.projectId` for organisation events, so per-organisation history is an index lookup.
  projectId    String?  @map("project_id") @db.VarChar(36)
  ip           String?  @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

/// Platform-wide settings managed by system admins (single row, key = "default").
model SiteSetting {
  id                     String    @id @default(uuid())
  key                    String    @unique @default("default") @db.VarChar(32)
  maintenanceEnabled     Boolean   @default(false) @map("maintenance_enabled")
  maintenanceStartedAt   DateTime? @map("maintenance_started_at")
  /// Secret path segment for the admin sign-in link while maintenance is on.
  maintenanceBypassToken String?   @map("maintenance_bypass_token") @db.VarChar(128)
  /// Uploaded site logo (also the favicon) under PROC_LEARN_UPLOAD_ROOT; null = bundled default.
  logoStorageKey         String?   @map("logo_storage_key") @db.VarChar(255)
  logoMimeType           String?   @map("logo_mime_type") @db.VarChar(64)
  /// Uploaded sign-in background image; null = bundled default.
  backgroundStorageKey   String?   @map("background_storage_key") @db.VarChar(255)
  backgroundMimeType     String?   @map("background_mime_type") @db.VarChar(64)
  updatedByUserId        String?   @map("updated_by_user_id") @db.VarChar(36)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("site_setting")
}

model Notification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    @db.VarChar(64)
  title        String    @db.VarChar(255)
  body         String    @db.Text
  /// When set, this row is shown only while that role is the user’s active role. Null = any active role.
  audienceRole Role?     @map("audience_role")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, audienceRole, readAt])
  @@map("notification")
}

/// In-app notifications for simulated organisation users (org-session bell).
model ProjectOrgNotification {
  id                 String         @id @default(uuid())
  projectId          String         @map("project_id")
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientOrgUserId String         @map("recipient_org_user_id")
  recipient          ProjectOrgUser @relation(fields: [recipientOrgUserId], references: [id], onDelete: Cascade)
  type               String         @db.VarChar(64)
  title              String         @db.VarChar(255)
  body               String         @db.Text
  linkUrl            String?        @map("link_url") @db.VarChar(512)
  relatedEntityType  String?        @map("related_entity_type") @db.VarChar(64)
  relatedEntityId    String?        @map("related_entity_id") @db.VarChar(36)
  readAt             DateTime?      @map("read_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([recipientOrgUserId, readAt, createdAt])
  @@index([projectId, createdAt])
  @@map("project_org_notification")
}

/// Binary files live under PROC_LEARN_UPLOAD_ROOT (never in /public). Served only via /api/media/[id].
model MediaObject {
  id          String   @id @default(uuid())
  ownerUserId String   @map("owner_user_id")
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  purpose     String   @db.VarChar(32)
  mimeType    String   @map("mime_type") @db.VarChar(127)
  storageKey  String   @unique @map("storage_key") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("media_object")
}

model Project {
  id                      String            @id @default(uuid())
  ownerUserId             String            @map("owner_user_id")
  owner                   User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  creatorRole             Role              @map("creator_role")
  name                    String            @db.VarChar(255)
  description             String?           @db.Text
  organizationName        String?           @map("organization_name") @db.VarChar(255)
  /// Government vote / head number assigned to the entity (prints on requisitions as Vote/Head No.).
  voteCode                String?           @map("vote_code") @db.VarChar(8)
  purpose                 ProjectPurpose    @default(PRACTICE)
  status                  ProjectStatus     @default(NOT_STARTED)
  visibility              ProjectVisibility @default(PRIVATE)
  instructions            String?           @db.Text
  questionText            String?           @map("question_text") @db.Text
  questionFileUrl         String?           @map("question_file_url") @db.VarChar(2048)
  isPublished             Boolean           @default(false) @map("is_published")
  openAt                  DateTime?         @map("open_at")
  closeAt                 DateTime?         @map("close_at")
  durationSeconds         Int?              @map("duration_seconds")
  /// Max ProjectAttempt rows per enrollment. Null = unlimited (typical Practice).
  maxAttempts             Int?              @map("max_attempts")
  /// When false, submitted attempts cannot be reopened for further edits.
  allowEditAfterSubmit    Boolean           @default(false) @map("allow_edit_after_submit")
  enrollmentKey           String?           @map("enrollment_key") @db.VarChar(16)
  requiresEnrollment      Boolean           @default(false) @map("requires_enrollment")
  /// Short immutable code that distinguishes this project/organisation (e.g. ORG-A1B2C3).
  projectCode             String?           @unique @map("project_code") @db.VarChar(16)
  /// True for the student's home organisation (one per student owner).
  isPersonalOrg           Boolean           @default(false) @map("is_personal_org")
  /// Isolated organisation shell created when a student starts a Practice/Assessment attempt.
  isAttemptOrg            Boolean           @default(false) @map("is_attempt_org")
  /// Academic project (examiner PRACTICE/ASSESSMENT) this attempt workspace was created for.
  sourceAcademicProjectId String?           @map("source_academic_project_id")
  sourceAcademicProject   Project?          @relation("AcademicProjectWorkspaces", fields: [sourceAcademicProjectId], references: [id], onDelete: Cascade)
  attemptWorkspaces       Project[]         @relation("AcademicProjectWorkspaces")
  /// Academic context for Practice / Assessment projects (examiner-created).
  academicYearId          String?           @map("academic_year_id")
  academicYear            AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  programmeId             String?           @map("programme_id")
  programme               Programme?        @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  enrollments                   ProjectEnrollment[]
  /// Campuses allowed to take an examiner project. No rows = all campuses.
  campuses                      ProjectCampus[]
  orgUsers                      ProjectOrgUser[]
  orgDepartments                ProjectOrgDepartment[]
  orgFinancialYears             ProjectOrgFinancialYear[]
  orgPlanningPeriods            ProjectOrgPlanningPeriod[]
  orgProcessFlowAdoptions       ProjectOrgProcessFlowAdoption[]
  orgCommittees                 ProjectOrgCommittee[]
  orgProcurementPlans           ProjectOrgProcurementPlan[]
  orgBudgets                    ProjectOrgBudget[]
  orgBudgetLines                ProjectOrgBudgetLine[]
  orgRequisitions               ProjectOrgRequisition[]
  orgProcurements               ProjectOrgProcurement[]
  orgProcurementRecommendations ProjectOrgProcurementRecommendation[]
  orgDeliveryNotes              ProjectOrgDeliveryNote[]
  orgProviderNotifications      ProjectOrgProviderNotification[]
  orgProviders                  ProjectOrgProvider[]
  orgNotifications              ProjectOrgNotification[]
  orgWorkflowInstances          ProjectOrgWorkflowInstance[]
  orgWorkflowTasks              ProjectOrgWorkflowTask[]
  orgWorkflowActions            ProjectOrgWorkflowAction[]
  orgAcademicSlates             OrgAcademicSlate[]
  orgFormDrafts                 ProjectOrgFormDraft[]
  assessment                    ProjectAssessment?
  workspaceAttempts             ProjectAttempt[]                      @relation("AttemptWorkspace")
  activeOrgForUsers             UserSettings[]                        @relation("UserActiveOrg")

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, isPersonalOrg])
  @@index([ownerUserId, isAttemptOrg])
  @@index([sourceAcademicProjectId])
  @@index([creatorRole, purpose, isPublished])
  @@index([visibility, isPublished])
  @@index([academicYearId, programmeId])
  @@map("project")
}

model ProjectCampus {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campus    Campus

  @@unique([projectId, campus])
  @@index([campus])
  @@map("project_campus")
}

model ProjectEnrollment {
  id            String                  @id @default(uuid())
  projectId     String                  @map("project_id")
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentUserId String                  @map("student_user_id")
  student       User                    @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  /// Compatibility rollup of latest attempt — source of truth for execution is ProjectAttempt.
  status        ProjectEnrollmentStatus @default(NOT_STARTED)
  enrolledAt    DateTime                @default(now()) @map("enrolled_at")
  startedAt     DateTime?               @map("started_at")
  submittedAt   DateTime?               @map("submitted_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  attempts ProjectAttempt[]

  @@unique([projectId, studentUserId])
  @@index([studentUserId, status])
  @@index([projectId, status])
  @@map("project_enrollment")
}

/// One execution of an Academic Project for an enrollment (retakes = multiple rows).
model ProjectAttempt {
  id                          String                     @id @default(uuid())
  enrollmentId                String                     @map("enrollment_id")
  enrollment                  ProjectEnrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  attemptNumber               Int                        @map("attempt_number")
  /// Organisation shell CURRENT slate when the attempt started (personal or attempt workspace).
  academicSlateId             String?                    @map("academic_slate_id")
  academicSlate               OrgAcademicSlate?          @relation(fields: [academicSlateId], references: [id], onDelete: SetNull)
  studentAcademicEnrollmentId String?                    @map("student_academic_enrollment_id")
  studentAcademicEnrollment   StudentAcademicEnrollment? @relation(fields: [studentAcademicEnrollmentId], references: [id], onDelete: SetNull)
  /// Isolated organisation Project this attempt is executed in (null = legacy personal-org attempts).
  workspaceProjectId          String?                    @map("workspace_project_id")
  workspaceProject            Project?                   @relation("AttemptWorkspace", fields: [workspaceProjectId], references: [id], onDelete: SetNull)
  status                      ProjectAttemptStatus       @default(NOT_STARTED)
  startedAt                   DateTime?                  @map("started_at")
  submittedAt                 DateTime?                  @map("submitted_at")
  /// Seconds of active work; primarily derived from startedAt→now/submit for the timer.
  durationSecondsUsed         Int                        @default(0) @map("duration_seconds_used")
  /// Cache only — progress is derived from the attempt workspace procurement domain.
  progressPercent             Int?                       @map("progress_percent")
  currentStageKey             String?                    @map("current_stage_key") @db.VarChar(64)
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  grade ProjectAttemptGrade?

  @@unique([enrollmentId, attemptNumber])
  @@index([enrollmentId, status])
  @@index([academicSlateId])
  @@index([studentAcademicEnrollmentId])
  @@index([workspaceProjectId])
  @@map("project_attempt")
}

/// Assessment configuration for an Academic Project (Practice or Assessment purpose).
/// Observes the real procurement domain — does not duplicate workflow rules.
model ProjectAssessment {
  id                  String                @id @default(uuid())
  projectId           String                @unique @map("project_id")
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gradingMode         AssessmentGradingMode @default(AUTOMATIC) @map("grading_mode")
  /// Examiner-entered marks cap (0 for AUTOMATIC). Auto cap = sum of active checkpoint marks.
  manualMaxMarks      Int                   @default(0) @map("manual_max_marks")
  /// Pass when finalPercent >= this value (default 50).
  passMarkPercent     Int                   @default(50) @map("pass_mark_percent")
  /// Total grade this project is scored out of. Allowed processes share this total.
  totalMarks          Int                   @default(100) @map("total_marks")
  /// When false, Practice projects skip scoring UI/eval (Assessment defaults to true).
  scoringEnabled      Boolean               @default(true) @map("scoring_enabled")
  /// When true, students may see their final score and feedback.
  resultsReleased     Boolean               @default(false) @map("results_released")
  /// What released results show students: score only, or the full section/item breakdown.
  resultsView         AssessmentResultsView @default(SUMMARY) @map("results_view")
  /// Engine process codes students may run in this project (Processes tab). Null = legacy:
  /// derived from the process sections switched on in scoring.
  enabledProcessCodes Json?                 @map("enabled_process_codes")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  checkpoints AssessmentCheckpoint[]
  processes   AssessmentProcess[]
  grades      ProjectAttemptGrade[]

  @@map("project_assessment")
}

model AssessmentCheckpoint {
  id                String                   @id @default(uuid())
  assessmentId      String                   @map("assessment_id")
  assessment        ProjectAssessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sortOrder         Int                      @default(0) @map("sort_order")
  label             String                   @db.VarChar(255)
  kind              AssessmentCheckpointKind
  /// For STAGE_COMPLETED / STAGE_REACHED — OBSERVATION_STAGE_KEYS value.
  stageKey          String?                  @map("stage_key") @db.VarChar(64)
  /// For PROCUREMENT_METHOD — OrgProcurementMethod value.
  procurementMethod String?                  @map("procurement_method") @db.VarChar(32)
  marks             Int
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@index([assessmentId, sortOrder])
  @@map("assessment_checkpoint")
}

/// One engine process in an Academic Project assessment. Allowed processes share totalMarks.
model AssessmentProcess {
  id           String            @id @default(uuid())
  assessmentId String            @map("assessment_id")
  assessment   ProjectAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Section key (e.g. BUDGETING, ORG_USERS) or item key "SECTION:ITEM".
  processCode  String            @map("process_code") @db.VarChar(64)
  sortOrder    Int               @default(0) @map("sort_order")
  isAllowed    Boolean           @default(true) @map("is_allowed")
  marks        Float             @default(0)
  /// When true, examiner set this mark; remaining allowed processes share what is left.
  marksPinned  Boolean           @default(false) @map("marks_pinned")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([assessmentId, processCode])
  @@index([assessmentId, sortOrder])
  @@map("assessment_process")
}

/// One grade per ProjectAttempt. Demo participation may have grades but is excluded from official stats/exports.
model ProjectAttemptGrade {
  id                String             @id @default(uuid())
  attemptId         String             @unique @map("attempt_id")
  attempt           ProjectAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentId      String             @map("assessment_id")
  assessment        ProjectAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  autoScore         Float              @default(0) @map("auto_score")
  manualScore       Int?               @map("manual_score")
  finalScore        Float?             @map("final_score")
  finalPercent      Int?               @map("final_percent")
  passFail          PassFailResult?    @map("pass_fail")
  feedback          String?            @db.Text
  status            AttemptGradeStatus @default(NOT_GRADED)
  /// Snapshot of checkpoint evaluations at last auto run.
  checkpointResults Json?              @map("checkpoint_results")
  gradedByUserId    String?            @map("graded_by_user_id")
  gradedBy          User?              @relation("AttemptGradedBy", fields: [gradedByUserId], references: [id], onDelete: SetNull)
  gradedAt          DateTime?          @map("graded_at")
  autoEvaluatedAt   DateTime?          @map("auto_evaluated_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([assessmentId, status])
  @@index([gradedByUserId])
  @@map("project_attempt_grade")
}

/// Global catalogue of organisation roles available inside student project workspaces.
model ProjectOrgRole {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(128)
  description String?  @db.VarChar(512)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orgUsers         ProjectOrgUser[]
  processFlowItems ProjectOrgProcessFlowItem[]

  @@index([isActive, sortOrder])
  @@map("project_org_role")
}

/// Department or subunit inside a student project organisation (hierarchical units).
model ProjectOrgDepartment {
  id          String                 @id @default(uuid())
  projectId   String                 @map("project_id")
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null = top-level unit; set = child under that parent unit.
  parentId    String?                @map("parent_id")
  parent      ProjectOrgDepartment?  @relation("ProjectOrgDepartmentTree", fields: [parentId], references: [id], onDelete: Cascade)
  subunits    ProjectOrgDepartment[] @relation("ProjectOrgDepartmentTree")
  name        String                 @db.VarChar(128)
  code        String?                @db.VarChar(32)
  unitType    OrgUnitType            @default(DEPARTMENT) @map("unit_type")
  description String?                @db.VarChar(512)
  isActive    Boolean                @default(true) @map("is_active")
  /// Sibling order within the same parent (top → bottom on Organisation Structure).
  sortOrder   Int                    @default(0) @map("sort_order")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  orgUsersAsDepartment ProjectOrgUser[]            @relation("OrgUserDepartment")
  orgUsersAsSubunit    ProjectOrgUser[]            @relation("OrgUserSubunit")
  budgets              ProjectOrgBudget[]
  procurementPlans     ProjectOrgProcurementPlan[]
  requisitions         ProjectOrgRequisition[]
  procurements         ProjectOrgProcurement[]
  budgetLines          ProjectOrgBudgetLine[]

  @@index([projectId, code])
  @@index([projectId, parentId, isActive])
  @@index([projectId, parentId, sortOrder])
  @@map("project_org_department")
}

/// Organisation user account inside a student project workspace (simulated, not a platform login).
model ProjectOrgUser {
  id               String                @id @default(uuid())
  projectId        String                @map("project_id")
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectOrgRoleId String                @map("project_org_role_id")
  projectOrgRole   ProjectOrgRole        @relation(fields: [projectOrgRoleId], references: [id], onDelete: Restrict)
  /// True for the project owner's immutable Organization Administrator row (synced from their student account).
  isProjectAdmin   Boolean               @default(false) @map("is_project_admin")
  /// Platform user id when this row represents the project owner.
  linkedUserId     String?               @map("linked_user_id") @db.VarChar(36)
  departmentId     String?               @map("department_id")
  department       ProjectOrgDepartment? @relation("OrgUserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  subunitId        String?               @map("subunit_id")
  subunit          ProjectOrgDepartment? @relation("OrgUserSubunit", fields: [subunitId], references: [id], onDelete: SetNull)
  firstName        String                @map("first_name") @db.VarChar(100)
  lastName         String                @map("last_name") @db.VarChar(100)
  /// Org users: `firstname.lastname@<orgcode>.<appname>` (the login). Admin row: the owner's platform email.
  email            String                @db.VarChar(255)
  /// Bcrypt hash for simulated org logins (null for project-owner Admin row).
  passwordHash     String?               @map("password_hash") @db.VarChar(255)
  lastLoginAt      DateTime?             @map("last_login_at")
  theme            String                @default("light") @db.VarChar(16)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  committeeMemberships       ProjectOrgCommitteeMember[]
  assignedTasks              ProjectOrgWorkflowTask[]              @relation("WorkflowTaskAssignee")
  workflowActions            ProjectOrgWorkflowAction[]            @relation("WorkflowActionActor")
  requisitionsCreated        ProjectOrgRequisition[]               @relation("RequisitionRequester")
  procurementPlansCreated    ProjectOrgProcurementPlan[]           @relation("ProcurementPlanCreator")
  budgetsCreated             ProjectOrgBudget[]                    @relation("BudgetCreator")
  budgetsApproved            ProjectOrgBudget[]                    @relation("BudgetApprover")
  procurementPlansApproved   ProjectOrgProcurementPlan[]           @relation("ProcurementPlanApprover")
  requisitionsApproved       ProjectOrgRequisition[]               @relation("RequisitionApprover")
  procurementsAsOfficer      ProjectOrgProcurement[]               @relation("ProcurementOfficer")
  procurementsClosed         ProjectOrgProcurement[]               @relation("ProcurementCloser")
  purchaseInstructionsIssued ProjectOrgPurchaseInstruction[]       @relation("PurchaseInstructionIssuer")
  awardsApproved             ProjectOrgAward[]                     @relation("AwardApprover")
  deliveriesRecorded         ProjectOrgDelivery[]                  @relation("DeliveryRecorder")
  providersCreated           ProjectOrgProvider[]                  @relation("ProviderCreator")
  inspectionsRecorded        ProjectOrgInspection[]                @relation("InspectionRecorder")
  invoicesCreated            ProjectOrgInvoice[]                   @relation("InvoiceCreator")
  paymentsApproved           ProjectOrgPayment[]                   @relation("PaymentApprover")
  recommendationsMade        ProjectOrgProcurementRecommendation[] @relation("RecommendationRecommender")
  recommendationsDecided     ProjectOrgProcurementRecommendation[] @relation("RecommendationDecider")
  orgNotifications           ProjectOrgNotification[]
  formDrafts                 ProjectOrgFormDraft[]
  /// Committee currently "active" for this user's session (evaluation/PQ report authoring context).
  activeCommitteeId          String?                               @map("active_committee_id")
  activeCommittee            ProjectOrgCommittee?                  @relation("OrgUserActiveCommittee", fields: [activeCommitteeId], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@unique([projectId, linkedUserId])
  @@index([projectId, isProjectAdmin, createdAt])
  @@index([projectId, departmentId])
  @@index([projectId, firstName, lastName])
  @@map("project_org_user")
}

/// Debounced in-progress form payloads (cross-device resume). One row per actor + form key.
model ProjectOrgFormDraft {
  id             String          @id @default(uuid())
  projectId      String          @map("project_id")
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// `org:<orgUserId>` or `user:<platformUserId>` — avoids MySQL NULL-unique pitfalls.
  actorScope     String          @map("actor_scope") @db.VarChar(80)
  orgUserId      String?         @map("org_user_id")
  orgUser        ProjectOrgUser? @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  platformUserId String?         @map("platform_user_id") @db.VarChar(36)
  /// Stable form id, e.g. `procurement-plan:new`, `form5:I:<requisitionId>`.
  formKey        String          @map("form_key") @db.VarChar(160)
  payload        Json
  /// Approximate UTF-8 size for quotas / abuse guards.
  payloadBytes   Int             @default(0) @map("payload_bytes")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([projectId, actorScope, formKey])
  @@index([projectId, orgUserId, updatedAt])
  @@index([projectId, platformUserId, updatedAt])
  @@map("project_org_form_draft")
}

/// Financial year inside a student project organisation.
model ProjectOrgFinancialYear {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Label such as "2026/2027".
  label       String   @db.VarChar(16)
  description String?  @db.VarChar(512)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  /// Alias for “is current” financial year in the organisation.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planningPeriods  ProjectOrgPlanningPeriod[]
  budgets          ProjectOrgBudget[]
  budgetLines      ProjectOrgBudgetLine[]
  procurementPlans ProjectOrgProcurementPlan[]
  requisitions     ProjectOrgRequisition[]
  procurements     ProjectOrgProcurement[]

  @@unique([projectId, label])
  @@index([projectId, isActive, startDate])
  @@map("project_org_financial_year")
}

/// Planning period inside a student project organisation (belongs to a financial year).
model ProjectOrgPlanningPeriod {
  id              String                  @id @default(uuid())
  projectId       String                  @map("project_id")
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  financialYearId String                  @map("financial_year_id")
  financialYear   ProjectOrgFinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  /// Optional display name (e.g. "Annual planning 2026/2027").
  label           String?                 @db.VarChar(128)
  startDate       DateTime                @map("start_date") @db.Date
  endDate         DateTime                @map("end_date") @db.Date
  /// Cached administrative status; list/detail APIs recompute from server calendar dates.
  status          OrgPlanningPeriodStatus @default(UPCOMING)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  procurementPlans ProjectOrgProcurementPlan[]

  @@index([projectId, financialYearId, startDate])
  @@map("project_org_planning_period")
}

/// Global catalogue of process flows available inside student project workspaces.
model ProjectOrgProcessFlow {
  id          String   @id @default(uuid())
  /// Stable catalogue key e.g. PROCUREMENT_REQUISITION (optional for legacy rows).
  code        String?  @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  /// Business trigger that starts an instance once activated (e.g. REQUISITION_SUBMITTED).
  triggerKey  String?  @map("trigger_key") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items     ProjectOrgProcessFlowItem[]
  adoptions ProjectOrgProcessFlowAdoption[]
  instances ProjectOrgWorkflowInstance[]

  @@index([name, createdAt])
  @@index([triggerKey])
  @@map("project_org_process_flow")
}

/// Ordered step inside a project process flow.
model ProjectOrgProcessFlowItem {
  id               String                @id @default(uuid())
  processFlowId    String                @map("process_flow_id")
  processFlow      ProjectOrgProcessFlow @relation(fields: [processFlowId], references: [id], onDelete: Cascade)
  stepNumber       Int                   @map("step_number")
  taskDescription  String                @map("task_description") @db.VarChar(512)
  projectOrgRoleId String                @map("project_org_role_id")
  projectOrgRole   ProjectOrgRole        @relation(fields: [projectOrgRoleId], references: [id], onDelete: Restrict)
  /// Optional action key for engine routing (SUBMIT, APPROVE, VERIFY, …).
  actionKey        String?               @map("action_key") @db.VarChar(64)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tasks ProjectOrgWorkflowTask[]

  @@unique([processFlowId, stepNumber])
  @@index([processFlowId, stepNumber])
  @@map("project_org_process_flow_item")
}

/// Process template adopted into an organisation; activation makes it triggerable.
model ProjectOrgProcessFlowAdoption {
  id            String                @id @default(uuid())
  projectId     String                @map("project_id")
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processFlowId String                @map("process_flow_id")
  processFlow   ProjectOrgProcessFlow @relation(fields: [processFlowId], references: [id], onDelete: Cascade)
  /// False = adopted but inactive (templates are available; triggers do not run).
  isActive      Boolean               @default(true) @map("is_active")
  activatedAt   DateTime?             @map("activated_at")
  deactivatedAt DateTime?             @map("deactivated_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@unique([projectId, processFlowId])
  @@index([projectId, isActive, createdAt])
  @@map("project_org_process_flow_adoption")
}

/// Committee entity inside an organisation (separate from org roles).
model ProjectOrgCommittee {
  id            String           @id @default(uuid())
  projectId     String           @map("project_id")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String           @db.VarChar(128)
  committeeType OrgCommitteeType @map("committee_type")
  description   String?          @db.VarChar(512)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  members           ProjectOrgCommitteeMember[]
  evaluationReports ProjectOrgEvaluationReport[]
  activeForUsers    ProjectOrgUser[]             @relation("OrgUserActiveCommittee")

  @@unique([projectId, name])
  @@index([projectId, committeeType, isActive])
  @@map("project_org_committee")
}

model ProjectOrgCommitteeMember {
  id            String                       @id @default(uuid())
  committeeId   String                       @map("committee_id")
  committee     ProjectOrgCommittee          @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  orgUserId     String                       @map("org_user_id")
  orgUser       ProjectOrgUser               @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  committeeRole OrgCommitteeMemberRole       @map("committee_role")
  startDate     DateTime                     @map("start_date") @db.Date
  endDate       DateTime?                    @map("end_date") @db.Date
  status        OrgCommitteeMembershipStatus @default(ACTIVE)
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  @@unique([committeeId, orgUserId])
  @@index([orgUserId, status])
  @@map("project_org_committee_member")
}

/// Budget header for an organisation financial year (and optional department).
/// Business record — operational users prepare/approve; Organization Administrator only configures the system.
model ProjectOrgBudget {
  id                  String                  @id @default(uuid())
  projectId           String                  @map("project_id")
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  financialYearId     String                  @map("financial_year_id")
  financialYear       ProjectOrgFinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  departmentId        String?                 @map("department_id")
  department          ProjectOrgDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title               String                  @db.VarChar(255)
  description         String?                 @db.Text
  /// Human-readable budget reference e.g. ICT-BUD-2026-001
  budgetReference     String?                 @map("budget_reference") @db.VarChar(64)
  currency            String                  @default("UGX") @db.VarChar(8)
  status              OrgBudgetStatus         @default(DRAFT)
  createdByOrgUserId  String?                 @map("created_by_org_user_id")
  createdBy           ProjectOrgUser?         @relation("BudgetCreator", fields: [createdByOrgUserId], references: [id], onDelete: SetNull)
  submittedAt         DateTime?               @map("submitted_at")
  approvedAt          DateTime?               @map("approved_at")
  approvedByOrgUserId String?                 @map("approved_by_org_user_id")
  approvedBy          ProjectOrgUser?         @relation("BudgetApprover", fields: [approvedByOrgUserId], references: [id], onDelete: SetNull)
  /// Additive academic-year participation context (nullable for legacy / non-personal orgs).
  orgAcademicSlateId  String?                 @map("org_academic_slate_id")
  orgAcademicSlate    OrgAcademicSlate?       @relation(fields: [orgAcademicSlateId], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  lines     ProjectOrgBudgetLine[]
  instances ProjectOrgWorkflowInstance[]

  @@unique([projectId, budgetReference])
  @@index([projectId, financialYearId, status])
  @@index([departmentId, status])
  @@index([orgAcademicSlateId])
  @@map("project_org_budget")
}

/// Budget line used for funding verification and plan-item linkage.
model ProjectOrgBudgetLine {
  id              String                  @id @default(uuid())
  projectId       String                  @map("project_id")
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetId        String?                 @map("budget_id")
  budget          ProjectOrgBudget?       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  financialYearId String                  @map("financial_year_id")
  financialYear   ProjectOrgFinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  departmentId    String?                 @map("department_id")
  department      ProjectOrgDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  code            String                  @db.VarChar(64)
  name            String                  @db.VarChar(255)
  description     String?                 @db.Text
  category        String?                 @db.VarChar(128)
  quantity        Decimal?                @db.Decimal(18, 2)
  unitOfMeasure   String?                 @map("unit_of_measure") @db.VarChar(64)
  unitCost        Decimal?                @map("unit_cost") @db.Decimal(18, 2)
  /// Authoritative line total (server-calculated when qty × unitCost provided).
  approvedAmount  Decimal                 @map("approved_amount") @db.Decimal(18, 2)
  committedAmount Decimal                 @default(0) @map("committed_amount") @db.Decimal(18, 2)
  fundingSource   String?                 @map("funding_source") @db.VarChar(128)
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  requisitions         ProjectOrgRequisition[]
  procurementPlanItems ProjectOrgProcurementPlanItem[]
  procurements         ProjectOrgProcurement[]

  @@unique([projectId, financialYearId, code])
  @@index([projectId, financialYearId, isActive])
  @@index([budgetId])
  @@map("project_org_budget_line")
}

model ProjectOrgProcurementPlan {
  id                     String                      @id @default(uuid())
  projectId              String                      @map("project_id")
  project                Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  financialYearId        String                      @map("financial_year_id")
  financialYear          ProjectOrgFinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  planningPeriodId       String?                     @map("planning_period_id")
  planningPeriod         ProjectOrgPlanningPeriod?   @relation(fields: [planningPeriodId], references: [id], onDelete: SetNull)
  /// Null for organisation-level consolidated plan shells.
  departmentId           String?                     @map("department_id")
  department             ProjectOrgDepartment?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// Human-readable plan reference e.g. ICT-PP-2026-001
  planReference          String?                     @map("plan_reference") @db.VarChar(64)
  title                  String                      @db.VarChar(255)
  /// Circular 1/2024 sheet: GOODS_WORKS_NON_CONSULTANCY | CONSULTANCY
  sheetType              String                      @default("GOODS_WORKS_NON_CONSULTANCY") @map("sheet_type") @db.VarChar(48)
  /// True = emergency / unplanned plan (uses Emergency Planning Process).
  isEmergency            Boolean                     @default(false) @map("is_emergency")
  /// Why the need is urgent, unforeseeable and not caused by dilatory conduct (emergency plans only).
  emergencyJustification String?                     @map("emergency_justification") @db.Text
  status                 OrgProcurementPlanStatus    @default(DRAFT)
  /// When set, this plan is an organisation-level consolidation of department plans.
  isConsolidated         Boolean                     @default(false) @map("is_consolidated")
  /// Parent consolidated plan this departmental plan was linked into (MVP).
  consolidatedIntoPlanId String?                     @map("consolidated_into_plan_id")
  consolidatedInto       ProjectOrgProcurementPlan?  @relation("PlanConsolidation", fields: [consolidatedIntoPlanId], references: [id], onDelete: SetNull)
  sourcePlans            ProjectOrgProcurementPlan[] @relation("PlanConsolidation")
  createdByOrgUserId     String?                     @map("created_by_org_user_id")
  createdBy              ProjectOrgUser?             @relation("ProcurementPlanCreator", fields: [createdByOrgUserId], references: [id], onDelete: SetNull)
  submittedAt            DateTime?                   @map("submitted_at")
  approvedAt             DateTime?                   @map("approved_at")
  approvedByOrgUserId    String?                     @map("approved_by_org_user_id")
  approvedBy             ProjectOrgUser?             @relation("ProcurementPlanApprover", fields: [approvedByOrgUserId], references: [id], onDelete: SetNull)
  orgAcademicSlateId     String?                     @map("org_academic_slate_id")
  orgAcademicSlate       OrgAcademicSlate?           @relation(fields: [orgAcademicSlateId], references: [id], onDelete: SetNull)
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")

  items        ProjectOrgProcurementPlanItem[]
  requisitions ProjectOrgRequisition[]
  instances    ProjectOrgWorkflowInstance[]

  @@unique([projectId, planReference])
  @@index([projectId, financialYearId, status])
  @@index([departmentId, status])
  @@index([planningPeriodId])
  @@index([consolidatedIntoPlanId])
  @@index([orgAcademicSlateId])
  @@map("project_org_procurement_plan")
}

model ProjectOrgProcurementPlanItem {
  id                        String                    @id @default(uuid())
  procurementPlanId         String                    @map("procurement_plan_id")
  procurementPlan           ProjectOrgProcurementPlan @relation(fields: [procurementPlanId], references: [id], onDelete: Cascade)
  itemNumber                Int                       @map("item_number")
  title                     String                    @db.VarChar(255)
  description               String?                   @db.Text
  specification             String?                   @db.Text
  category                  String?                   @db.VarChar(128)
  quantity                  Decimal                   @db.Decimal(18, 2)
  unitOfMeasure             String                    @map("unit_of_measure") @db.VarChar(64)
  estimatedUnitPrice        Decimal                   @map("estimated_unit_price") @db.Decimal(18, 2)
  estimatedTotal            Decimal                   @map("estimated_total") @db.Decimal(18, 2)
  budgetLineId              String?                   @map("budget_line_id")
  budgetLine                ProjectOrgBudgetLine?     @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  expectedProcurementPeriod String?                   @map("expected_procurement_period") @db.VarChar(32)
  priority                  String?                   @db.VarChar(32)
  justification             String?                   @db.Text
  remarks                   String?                   @db.Text
  /// Circular 1/2024 teaching columns (currency, multi-year, method, reservation, milestones, …).
  circularFields            Json?                     @map("circular_fields")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")

  requisitions ProjectOrgRequisition[]
  procurements ProjectOrgProcurement[]

  @@unique([procurementPlanId, itemNumber])
  @@index([budgetLineId])
  @@map("project_org_procurement_plan_item")
}

model ProjectOrgRequisition {
  id                    String                         @id @default(uuid())
  projectId             String                         @map("project_id")
  project               Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  financialYearId       String                         @map("financial_year_id")
  financialYear         ProjectOrgFinancialYear        @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  departmentId          String                         @map("department_id")
  department            ProjectOrgDepartment           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  procurementPlanId     String?                        @map("procurement_plan_id")
  procurementPlan       ProjectOrgProcurementPlan?     @relation(fields: [procurementPlanId], references: [id], onDelete: SetNull)
  procurementPlanItemId String?                        @map("procurement_plan_item_id")
  procurementPlanItem   ProjectOrgProcurementPlanItem? @relation(fields: [procurementPlanItemId], references: [id], onDelete: SetNull)
  budgetLineId          String?                        @map("budget_line_id")
  budgetLine            ProjectOrgBudgetLine?          @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  requesterOrgUserId    String                         @map("requester_org_user_id")
  requester             ProjectOrgUser                 @relation("RequisitionRequester", fields: [requesterOrgUserId], references: [id], onDelete: Restrict)
  /// Human-readable requisition reference e.g. ICT-REQ-2026-001
  requisitionReference  String?                        @map("requisition_reference") @db.VarChar(64)
  title                 String                         @db.VarChar(255)
  category              String?                        @db.VarChar(128)
  justification         String                         @db.Text
  needDescription       String                         @map("need_description") @db.Text
  requiredByDate        DateTime?                      @map("required_by_date") @db.Date
  deliveryLocation      String?                        @map("delivery_location") @db.VarChar(255)
  requestedDeliveryDate DateTime?                      @map("requested_delivery_date") @db.Date
  remarks               String?                        @db.Text
  estimatedTotalValue   Decimal                        @map("estimated_total_value") @db.Decimal(18, 2)
  status                OrgRequisitionStatus           @default(DRAFT)
  procurementMethod     OrgProcurementMethod?          @map("procurement_method")
  /// PPDA Form 5 Part I snapshot (Fill-and-submit teaching form).
  form5PartI            Json?                          @map("form5_part_i")
  /// PPDA Form 5 Part II snapshot (PDU recommendation; Contracts Committee approves method).
  form5PartII           Json?                          @map("form5_part_ii")
  form5PartIAt          DateTime?                      @map("form5_part_i_at")
  form5PartIIAt         DateTime?                      @map("form5_part_ii_at")
  submittedAt           DateTime?                      @map("submitted_at")
  approvedAt            DateTime?                      @map("approved_at")
  approvedByOrgUserId   String?                        @map("approved_by_org_user_id")
  approvedBy            ProjectOrgUser?                @relation("RequisitionApprover", fields: [approvedByOrgUserId], references: [id], onDelete: SetNull)
  orgAcademicSlateId    String?                        @map("org_academic_slate_id")
  orgAcademicSlate      OrgAcademicSlate?              @relation(fields: [orgAcademicSlateId], references: [id], onDelete: SetNull)
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  items        ProjectOrgRequisitionItem[]
  instances    ProjectOrgWorkflowInstance[]
  procurements ProjectOrgProcurement[]

  @@unique([projectId, requisitionReference])
  @@index([projectId, status, createdAt])
  @@index([requesterOrgUserId, status])
  @@index([departmentId, status])
  @@index([orgAcademicSlateId])
  @@map("project_org_requisition")
}

model ProjectOrgRequisitionItem {
  id                 String                @id @default(uuid())
  requisitionId      String                @map("requisition_id")
  requisition        ProjectOrgRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  lineNumber         Int                   @map("line_number")
  itemName           String                @map("item_name") @db.VarChar(255)
  description        String?               @db.Text
  specification      String?               @db.Text
  quantity           Decimal               @db.Decimal(18, 2)
  unitOfMeasure      String                @map("unit_of_measure") @db.VarChar(64)
  estimatedUnitPrice Decimal               @map("estimated_unit_price") @db.Decimal(18, 2)
  estimatedTotal     Decimal               @map("estimated_total") @db.Decimal(18, 2)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@unique([requisitionId, lineNumber])
  @@map("project_org_requisition_item")
}

/// Post-requisition procurement transaction (distinct from the requisition itself).
model ProjectOrgProcurement {
  id                        String                         @id @default(uuid())
  projectId                 String                         @map("project_id")
  project                   Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Human-readable id e.g. PROC-2026-0001
  procurementNumber         String                         @map("procurement_number") @db.VarChar(32)
  financialYearId           String                         @map("financial_year_id")
  financialYear             ProjectOrgFinancialYear        @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  departmentId              String                         @map("department_id")
  department                ProjectOrgDepartment           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requisitionId             String                         @unique @map("requisition_id")
  requisition               ProjectOrgRequisition          @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  procurementPlanItemId     String?                        @map("procurement_plan_item_id")
  procurementPlanItem       ProjectOrgProcurementPlanItem? @relation(fields: [procurementPlanItemId], references: [id], onDelete: SetNull)
  budgetLineId              String?                        @map("budget_line_id")
  budgetLine                ProjectOrgBudgetLine?          @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  title                     String                         @db.VarChar(255)
  procurementMethod         OrgProcurementMethod           @map("procurement_method")
  status                    OrgProcurementStatus           @default(METHOD_SELECTED)
  /// When true (or method is TENDER), a Post-Qualification report is required before award.
  requiresPostQualification Boolean                        @default(false) @map("requires_post_qualification")
  officerOrgUserId          String?                        @map("officer_org_user_id")
  officer                   ProjectOrgUser?                @relation("ProcurementOfficer", fields: [officerOrgUserId], references: [id], onDelete: SetNull)
  methodSelectedAt          DateTime?                      @map("method_selected_at")
  closedAt                  DateTime?                      @map("closed_at")
  closedByOrgUserId         String?                        @map("closed_by_org_user_id")
  closedBy                  ProjectOrgUser?                @relation("ProcurementCloser", fields: [closedByOrgUserId], references: [id], onDelete: SetNull)
  closureRemarks            String?                        @map("closure_remarks") @db.Text
  orgAcademicSlateId        String?                        @map("org_academic_slate_id")
  orgAcademicSlate          OrgAcademicSlate?              @relation(fields: [orgAcademicSlateId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")

  instances                ProjectOrgWorkflowInstance[]
  purchaseInstructions     ProjectOrgPurchaseInstruction[]
  solicitations            ProjectOrgSolicitation[]
  offers                   ProjectOrgOffer[]
  evaluationReports        ProjectOrgEvaluationReport[]
  postQualificationReports ProjectOrgPostQualificationReport[]
  awards                   ProjectOrgAward[]
  contracts                ProjectOrgContract[]
  lpos                     ProjectOrgLpo[]
  deliveries               ProjectOrgDelivery[]
  invoices                 ProjectOrgInvoice[]
  payments                 ProjectOrgPayment[]
  recommendations          ProjectOrgProcurementRecommendation[]
  deliveryNotes            ProjectOrgDeliveryNote[]

  @@unique([projectId, procurementNumber])
  @@index([projectId, status, createdAt])
  @@index([departmentId, status])
  @@index([financialYearId, status])
  @@index([orgAcademicSlateId])
  @@map("project_org_procurement")
}

/// Organisation-scoped provider register (suppliers, contractors, service providers, consultants).
/// Table name kept as project_org_supplier so existing rows are preserved.
model ProjectOrgProvider {
  id                 String            @id @default(uuid())
  projectId          String            @map("project_id")
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String            @db.VarChar(255)
  email              String?           @db.VarChar(255)
  phone              String?           @db.VarChar(64)
  contactPerson      String?           @map("contact_person") @db.VarChar(160)
  physicalAddress    String?           @map("physical_address") @db.VarChar(255)
  /// URSB company / business registration number.
  registrationRef    String?           @map("registration_ref") @db.VarChar(128)
  tin                String?           @db.VarChar(32)
  /// Array of provider category keys (GOODS, WORKS, NON_CONSULTANCY, CONSULTANCY).
  categories         Json?
  linesOfBusiness    String?           @map("lines_of_business") @db.VarChar(500)
  /// Simulated compliance documents keyed by document code: { held, number, expiresAt }.
  compliance         Json?
  /// Simulated PPDA suspended-providers list flag (regulator side).
  ppdaSuspended      Boolean           @default(false) @map("ppda_suspended")
  /// Simulated provider behaviour key used by auto-responses (see provider-behaviours.js).
  behaviour          String?           @db.VarChar(40)
  /// Conduct problems the provider shows (subset of NON_RESPONSIVE, LATE_SUBMITTER, COMPLIANT_EXPENSIVE, POOR_DELIVERY, INVOICE_MISMATCH). Empty = good conduct; null = derive from `behaviour`.
  conductIssues      Json?             @map("conduct_issues")
  isGenerated        Boolean           @default(false) @map("is_generated")
  status             OrgProviderStatus @default(ACTIVE)
  statusReason       String?           @map("status_reason") @db.VarChar(500)
  /// Base portal login email (scoped with project code at login).
  portalEmail        String?           @map("portal_email") @db.VarChar(255)
  portalPasswordHash String?           @map("portal_password_hash") @db.VarChar(255)
  portalLastLoginAt  DateTime?         @map("portal_last_login_at")
  createdByOrgUserId String?           @map("created_by_org_user_id")
  createdBy          ProjectOrgUser?   @relation("ProviderCreator", fields: [createdByOrgUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  purchaseInstructions      ProjectOrgPurchaseInstruction[]
  solicitationInvites       ProjectOrgSolicitationInvite[]
  offers                    ProjectOrgOffer[]
  evaluationReports         ProjectOrgEvaluationReport[]          @relation("EvaluationRecommendedSupplier")
  awards                    ProjectOrgAward[]
  contracts                 ProjectOrgContract[]
  lpos                      ProjectOrgLpo[]
  invoices                  ProjectOrgInvoice[]                   @relation("InvoiceSupplier")
  deliveryNotes             ProjectOrgDeliveryNote[]
  portalNotifications       ProjectOrgProviderNotification[]
  recommendationsAsCurrent  ProjectOrgProcurementRecommendation[] @relation("RecommendationCurrentProvider")
  recommendationsAsProposed ProjectOrgProcurementRecommendation[] @relation("RecommendationProposedProvider")

  @@unique([projectId, name])
  @@unique([projectId, portalEmail])
  @@index([projectId, status])
  @@map("project_org_supplier")
}

model ProjectOrgPurchaseInstruction {
  id                   String                       @id @default(uuid())
  projectId            String                       @map("project_id")
  procurementId        String                       @unique @map("procurement_id")
  procurement          ProjectOrgProcurement        @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  supplierId           String                       @map("supplier_id")
  supplier             ProjectOrgProvider           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  instructionNumber    String                       @map("instruction_number") @db.VarChar(32)
  amount               Decimal                      @db.Decimal(18, 2)
  status               OrgPurchaseInstructionStatus @default(DRAFT)
  issuedAt             DateTime?                    @map("issued_at")
  issuedByOrgUserId    String?                      @map("issued_by_org_user_id")
  issuedBy             ProjectOrgUser?              @relation("PurchaseInstructionIssuer", fields: [issuedByOrgUserId], references: [id], onDelete: SetNull)
  remarks              String?                      @db.Text
  deliveryAddress      String?                      @map("delivery_address") @db.VarChar(255)
  requiredDeliveryDate DateTime?                    @map("required_delivery_date")
  paymentTerms         String?                      @map("payment_terms") @db.Text
  specialInstructions  String?                      @map("special_instructions") @db.Text
  acceptedAt           DateTime?                    @map("accepted_at")
  acceptedByName       String?                      @map("accepted_by_name") @db.VarChar(160)
  declinedAt           DateTime?                    @map("declined_at")
  declineReason        String?                      @map("decline_reason") @db.Text
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@unique([projectId, instructionNumber])
  @@index([projectId, status])
  @@index([supplierId])
  @@map("project_org_purchase_instruction")
}

enum OrgProcurementRecommendationKind {
  CANCEL
  CHANGE_PROVIDER
  CHANGE_SHORTLIST
}

enum OrgProcurementRecommendationStatus {
  PENDING
  APPROVED
  DECLINED
}

/// PDU recommendation to the Contracts Committee (PPDA PDE Regulations 2023, reg. 14).
model ProjectOrgProcurementRecommendation {
  id                     String                             @id @default(uuid())
  projectId              String                             @map("project_id")
  project                Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  procurementId          String                             @map("procurement_id")
  procurement            ProjectOrgProcurement              @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  kind                   OrgProcurementRecommendationKind
  reason                 String                             @db.VarChar(48)
  details                String                             @db.Text
  alternative            String?                            @db.Text
  currentProviderId      String?                            @map("current_provider_id")
  currentProvider        ProjectOrgProvider?                @relation("RecommendationCurrentProvider", fields: [currentProviderId], references: [id], onDelete: SetNull)
  proposedProviderId     String?                            @map("proposed_provider_id")
  proposedProvider       ProjectOrgProvider?                @relation("RecommendationProposedProvider", fields: [proposedProviderId], references: [id], onDelete: SetNull)
  /// RFQ shortlist change: [{ id, name }] before and after.
  currentShortlist       Json?                              @map("current_shortlist")
  proposedShortlist      Json?                              @map("proposed_shortlist")
  status                 OrgProcurementRecommendationStatus @default(PENDING)
  recommendedByOrgUserId String?                            @map("recommended_by_org_user_id")
  recommendedBy          ProjectOrgUser?                    @relation("RecommendationRecommender", fields: [recommendedByOrgUserId], references: [id], onDelete: SetNull)
  recommendedByRoleName  String?                            @map("recommended_by_role_name") @db.VarChar(128)
  decidedByOrgUserId     String?                            @map("decided_by_org_user_id")
  decidedBy              ProjectOrgUser?                    @relation("RecommendationDecider", fields: [decidedByOrgUserId], references: [id], onDelete: SetNull)
  decidedByRoleName      String?                            @map("decided_by_role_name") @db.VarChar(128)
  committeeId            String?                            @map("committee_id") @db.VarChar(36)
  decisionComment        String?                            @map("decision_comment") @db.Text
  decidedAt              DateTime?                          @map("decided_at")
  createdAt              DateTime                           @default(now()) @map("created_at")
  updatedAt              DateTime                           @updatedAt @map("updated_at")

  @@index([projectId, procurementId, status])
  @@map("project_org_procurement_recommendation")
}

model ProjectOrgSolicitation {
  id                  String                @id @default(uuid())
  projectId           String                @map("project_id")
  procurementId       String                @map("procurement_id")
  procurement         ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  solicitationType    OrgSolicitationType   @map("solicitation_type")
  title               String                @db.VarChar(255)
  status              OrgSolicitationStatus @default(DRAFT)
  /// Educational bid / RFQ document filled in-app.
  bidDocument         Json?                 @map("bid_document")
  bidDocumentAt       DateTime?             @map("bid_document_at")
  issueDate           DateTime?             @map("issue_date")
  closingDate         DateTime?             @map("closing_date")
  /// Advertised deadline before submissions were closed early; default for a reopen.
  originalClosingDate DateTime?             @map("original_closing_date")
  openedAt            DateTime?             @map("opened_at")
  closedAt            DateTime?             @map("closed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  invites ProjectOrgSolicitationInvite[]
  offers  ProjectOrgOffer[]

  @@index([projectId, status])
  @@index([procurementId, solicitationType])
  @@map("project_org_solicitation")
}

model ProjectOrgSolicitationInvite {
  id             String                 @id @default(uuid())
  solicitationId String                 @map("solicitation_id")
  solicitation   ProjectOrgSolicitation @relation(fields: [solicitationId], references: [id], onDelete: Cascade)
  supplierId     String                 @map("supplier_id")
  supplier       ProjectOrgProvider     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invitedAt      DateTime               @default(now()) @map("invited_at")
  /// Set when the provider is recorded as not responding; cleared if it later submits.
  noResponseAt   DateTime?              @map("no_response_at")

  @@unique([solicitationId, supplierId])
  @@index([supplierId])
  @@map("project_org_solicitation_invite")
}

model ProjectOrgOffer {
  id             String                  @id @default(uuid())
  projectId      String                  @map("project_id")
  procurementId  String                  @map("procurement_id")
  procurement    ProjectOrgProcurement   @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  solicitationId String?                 @map("solicitation_id")
  solicitation   ProjectOrgSolicitation? @relation(fields: [solicitationId], references: [id], onDelete: SetNull)
  supplierId     String                  @map("supplier_id")
  supplier       ProjectOrgProvider      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  offerType      OrgOfferType            @map("offer_type")
  amount         Decimal                 @db.Decimal(18, 2)
  status         OrgOfferStatus          @default(SUBMITTED)
  submittedAt    DateTime                @default(now()) @map("submitted_at")
  openedAt       DateTime?               @map("opened_at")
  /// OFFICER (recorded by PDU), PORTAL (provider login) or AUTO (generated provider).
  source         String                  @default("OFFICER") @db.VarChar(16)
  deliveryDays   Int?                    @map("delivery_days")
  remarks        String?                 @db.Text
  /// Priced lines: [{ lineNumber, itemName, quantity, unitOfMeasure, unitPrice, total }].
  lineItems      Json?                   @map("line_items")
  withdrawnAt    DateTime?               @map("withdrawn_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  clarifications ProjectOrgOfferClarification[]

  @@index([projectId, procurementId, offerType])
  @@index([supplierId, status])
  @@index([solicitationId])
  @@map("project_org_offer")
}

/// Officer question on a received quotation/bid and the provider's reply (before closing).
model ProjectOrgOfferClarification {
  id             String          @id @default(uuid())
  projectId      String          @map("project_id")
  procurementId  String          @map("procurement_id")
  offerId        String          @map("offer_id")
  offer          ProjectOrgOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  supplierId     String          @map("supplier_id")
  question       String          @db.Text
  askedByName    String?         @map("asked_by_name") @db.VarChar(160)
  askedByRole    String?         @map("asked_by_role") @db.VarChar(120)
  askedAt        DateTime        @default(now()) @map("asked_at")
  response       String?         @db.Text
  /// PORTAL (provider login) or AUTO (auto-response provider).
  responseSource String?         @map("response_source") @db.VarChar(16)
  respondedAt    DateTime?       @map("responded_at")

  @@index([offerId])
  @@index([projectId, supplierId, respondedAt])
  @@map("project_org_offer_clarification")
}

model ProjectOrgEvaluationReport {
  id                    String                    @id @default(uuid())
  projectId             String                    @map("project_id")
  procurementId         String                    @map("procurement_id")
  procurement           ProjectOrgProcurement     @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  committeeId           String?                   @map("committee_id")
  committee             ProjectOrgCommittee?      @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  recommendedSupplierId String?                   @map("recommended_supplier_id")
  recommendedSupplier   ProjectOrgProvider?       @relation("EvaluationRecommendedSupplier", fields: [recommendedSupplierId], references: [id], onDelete: SetNull)
  evaluatedAmount       Decimal?                  @map("evaluated_amount") @db.Decimal(18, 2)
  recommendation        String?                   @db.Text
  comments              String?                   @db.Text
  scoresJson            Json?                     @map("scores_json")
  /// System "Run validation" eligibility results per bidder (learning mode: warnings only).
  eligibilityJson       Json?                     @map("eligibility_json")
  status                OrgEvaluationReportStatus @default(DRAFT)
  approvedAt            DateTime?                 @map("approved_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  participations ProjectOrgEvaluationParticipation[]

  @@index([projectId, procurementId, status])
  @@index([committeeId])
  @@map("project_org_evaluation_report")
}

model ProjectOrgEvaluationParticipation {
  id                 String                     @id @default(uuid())
  evaluationReportId String                     @map("evaluation_report_id")
  evaluationReport   ProjectOrgEvaluationReport @relation(fields: [evaluationReportId], references: [id], onDelete: Cascade)
  orgUserId          String                     @map("org_user_id")
  committeeRole      OrgCommitteeMemberRole?    @map("committee_role")
  conflictOfInterest Boolean                    @default(false) @map("conflict_of_interest")
  comments           String?                    @db.Text
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@unique([evaluationReportId, orgUserId])
  @@map("project_org_evaluation_participation")
}

model ProjectOrgPostQualificationReport {
  id                    String                     @id @default(uuid())
  projectId             String                     @map("project_id")
  procurementId         String                     @map("procurement_id")
  procurement           ProjectOrgProcurement      @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  supplierId            String?                    @map("supplier_id")
  registrationVerified  Boolean                    @default(false) @map("registration_verified")
  taxComplianceVerified Boolean                    @default(false) @map("tax_compliance_verified")
  experienceVerified    Boolean                    @default(false) @map("experience_verified")
  /// System "Run validation" result for the recommended bidder.
  validationJson        Json?                      @map("validation_json")
  comments              String?                    @db.Text
  status                OrgPostQualificationStatus @default(DRAFT)
  approvedAt            DateTime?                  @map("approved_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  @@index([projectId, procurementId, status])
  @@map("project_org_post_qualification_report")
}

model ProjectOrgAward {
  id                  String                @id @default(uuid())
  projectId           String                @map("project_id")
  procurementId       String                @map("procurement_id")
  procurement         ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  supplierId          String                @map("supplier_id")
  supplier            ProjectOrgProvider    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  awardedAmount       Decimal               @map("awarded_amount") @db.Decimal(18, 2)
  status              OrgAwardStatus        @default(DRAFT)
  awardDate           DateTime?             @map("award_date")
  communicatedAt      DateTime?             @map("communicated_at")
  acceptedAt          DateTime?             @map("accepted_at")
  /// Name of the provider's representative who accepted the award.
  acceptedByName      String?               @map("accepted_by_name") @db.VarChar(160)
  declinedAt          DateTime?             @map("declined_at")
  declineReason       String?               @map("decline_reason") @db.Text
  approvalReference   String?               @map("approval_reference") @db.VarChar(128)
  approvedByOrgUserId String?               @map("approved_by_org_user_id")
  approvedBy          ProjectOrgUser?       @relation("AwardApprover", fields: [approvedByOrgUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  contracts ProjectOrgContract[]
  lpos      ProjectOrgLpo[]

  @@index([projectId, procurementId, status])
  @@index([supplierId])
  @@map("project_org_award")
}

model ProjectOrgContract {
  id              String                @id @default(uuid())
  projectId       String                @map("project_id")
  procurementId   String                @map("procurement_id")
  procurement     ProjectOrgProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  awardId         String?               @map("award_id")
  award           ProjectOrgAward?      @relation(fields: [awardId], references: [id], onDelete: SetNull)
  supplierId      String                @map("supplier_id")
  supplier        ProjectOrgProvider    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  contractNumber  String                @map("contract_number") @db.VarChar(32)
  contractValue   Decimal               @map("contract_value") @db.Decimal(18, 2)
  status          OrgContractStatus     @default(DRAFT)
  startDate       DateTime?             @map("start_date")
  endDate         DateTime?             @map("end_date")
  issuedAt        DateTime?             @map("issued_at")
  acceptedAt      DateTime?             @map("accepted_at")
  /// Name of the provider's signatory who accepted in the portal.
  acceptedByName  String?               @map("accepted_by_name") @db.VarChar(160)
  declinedAt      DateTime?             @map("declined_at")
  declineReason   String?               @map("decline_reason") @db.Text
  deliveryAddress String?               @map("delivery_address") @db.VarChar(255)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([projectId, contractNumber])
  @@index([procurementId, status])
